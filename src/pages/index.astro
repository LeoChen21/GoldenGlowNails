---
import Layout from '../components/Layout.astro';
---

<Layout title="Golden Glow Nail Studio — Staten Island, NY">
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-text">
        <p class="eyebrow">Staten Island · Est. Golden Glow</p>
        <h1>Where every nail tells a story.</h1>
        <p class="lede">
          Custom nail art, spa manicures &amp; pedicures — crafted with care in the heart of Great Kills.
        </p>
        <div class="cta">
          <a href="tel:+17189847777" class="btn primary">Call (718) 984-7777</a>
          <a href="/gallery" class="btn secondary">See Our Work</a>
        </div>
      </div>
      <div class="hero-image">
        <img src="/photos/hero-fruit.png" alt="Colorful summer nail art with orange and floral designs" />
      </div>
    </div>
  </section>

  <section id="services" class="services container">
    <h2 data-reveal>What We Do</h2>
    <div class="service-grid">
      <article class="service-card" data-reveal>
        <h3>Manicures</h3>
        <p>Classic, gel, and acrylic finishes tailored to your style.</p>
      </article>
      <article class="service-card" data-reveal>
        <h3>Pedicures</h3>
        <p>Spa treatments, deluxe soaks, and polish that lasts.</p>
      </article>
      <article class="service-card" data-reveal>
        <h3>Nail Art</h3>
        <p>Hand-painted, jeweled, and 3D designs by our artists.</p>
      </article>
      <article class="service-card" data-reveal>
        <h3>Waxing</h3>
        <p>Brows, lip, and facial waxing for a polished finish.</p>
      </article>
    </div>
  </section>

  <section id="visit" class="visit container">
    <div class="visit-card" data-reveal>
      <div>
        <h2>Come Visit</h2>
        <p>
          150 Greaves Lane, Staten Island, NY 10308<br />
          Open Mon–Sat 9:30 AM – 7:30 PM · Sun 9 AM – 6 PM
        </p>
      </div>
      <div class="visit-cta">
        <a href="tel:+17189847777" class="btn primary">Call Now</a>
        <a
          href="https://www.google.com/maps/search/?api=1&query=150+Greaves+Lane+Staten+Island+NY+10308"
          class="btn secondary"
          target="_blank"
          rel="noopener"
        >Directions</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .hero {
    padding: 3rem 1.25rem 2rem;
  }

  .hero-inner {
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 3rem;
    align-items: center;
  }

  .eyebrow {
    color: var(--gold-deep);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin: 0 0 1rem;
  }

  .hero h1 {
    padding: 0;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
    line-height: 1.05;
  }

  .lede {
    font-size: 1.15rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0 0 1.75rem;
    max-width: 480px;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero-image img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    box-shadow: 0 20px 40px rgba(58, 46, 30, 0.2);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
      text-align: center;
    }
    .hero-text {
      order: 2;
    }
    .hero-image {
      order: 1;
      max-width: 340px;
      margin: 0 auto;
    }
    .cta {
      justify-content: center;
    }
    .lede {
      margin-left: auto;
      margin-right: auto;
    }
  }

  @media (max-width: 480px) {
    .hero {
      padding: 1.5rem 1rem 1rem;
    }
    .hero-image {
      max-width: 280px;
    }
    .cta .btn {
      width: 100%;
    }
    .visit-cta .btn {
      flex: 1 1 auto;
    }
  }

  .services h2 {
    text-align: center;
    margin: 0 0 2rem;
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .service-card {
    background: rgba(255, 255, 255, 0.85);
    border-radius: 16px;
    padding: 1.75rem;
    box-shadow: 0 4px 16px rgba(58, 46, 30, 0.08);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px rgba(58, 46, 30, 0.14);
  }

  .service-card h3 {
    margin: 0 0 0.5rem;
    color: var(--ink);
  }

  .service-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.55;
  }

  .visit-card {
    background: linear-gradient(135deg, rgba(232, 200, 128, 0.35), rgba(245, 230, 200, 0.55));
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .visit-card h2 {
    margin: 0 0 0.5rem;
  }

  .visit-card p {
    margin: 0;
    color: var(--ink);
    line-height: 1.6;
  }

  .visit-cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
