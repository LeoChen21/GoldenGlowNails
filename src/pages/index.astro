---
import Layout from '../components/Layout.astro';
import Background from '../components/Background.astro';
---

<Layout title="Golden Glow Nails">
	<main>
   <Background />
    <div id="content">
      <div class="header">
        <h1>Golden Glow Nails</h1>
        <h2>
          Where every nail tells a story. Book your appointment today.
        </h2>
        <div class="btns">
          <a href="#services" class="btn primary">Our Services</a>
          <a href="#contact" class="btn secondary">Book Now</a>
        </div>
      </div>
			<div class="resource-list">
        <ul>
          <li id="services"><strong>Manicures</strong> — classic, gel, and acrylic finishes</li>
          <li><strong>Pedicures</strong> — spa treatments and polish</li>
          <li><strong>Nail Art</strong> — custom designs by our artists</li>
          <li id="contact"><strong>Contact</strong> — hello@goldenglownails.com</li>
        </ul>
      </div>
    </div>
	</main>
</Layout>