---
import Layout from '../components/Layout.astro';
import Background from '../components/Background.astro';
---

<Layout title="Golden Glow Nail Studio — Staten Island, NY">
	<main>
    <Background />
    <div id="content">
      <section class="hero">
        <h1>Golden Glow Nail Studio</h1>
        <p class="tagline">Where every nail tells a story.</p>
        <div class="btns">
          <a href="tel:+17189847777" class="btn primary">Call (718) 984-7777</a>
          <a href="#visit" class="btn secondary">Plan Your Visit</a>
        </div>
      </section>

      <section class="services">
        <h2>Services</h2>
        <ul class="service-grid">
          <li><strong>Manicures</strong><span>Classic · Gel · Acrylic</span></li>
          <li><strong>Pedicures</strong><span>Spa · Deluxe · Polish change</span></li>
          <li><strong>Nail Art</strong><span>Custom designs by our artists</span></li>
          <li><strong>Waxing</strong><span>Brows · Lip · Facial</span></li>
        </ul>
      </section>

      <section id="visit" class="visit">
        <div class="visit-block">
          <h2>Visit Us</h2>
          <p>
            150 Greaves Lane<br />
            Staten Island, NY 10308
          </p>
          <p>
            <a href="tel:+17189847777">(718) 984-7777</a>
          </p>
          <p>
            <a
              href="https://www.google.com/maps/search/?api=1&query=150+Greaves+Lane+Staten+Island+NY+10308"
              target="_blank"
              rel="noopener"
            >Get Directions →</a>
          </p>
          <p>
            <a
              href="https://instagram.com/goldenglownail"
              target="_blank"
              rel="noopener"
            >Follow @goldenglownail on Instagram</a>
          </p>
        </div>

        <div class="visit-block">
          <h2>Hours</h2>
          <ul class="hours">
            <li><span>Mon – Sat</span><span>9:30 AM – 7:30 PM</span></li>
            <li><span>Sunday</span><span>9:00 AM – 6:00 PM</span></li>
          </ul>
          <p class="note">Open 7 days a week · Walk-ins welcome</p>
        </div>
      </section>

      <footer>
        <p>&copy; {new Date().getFullYear()} Golden Glow Nail Studio</p>
      </footer>
    </div>
	</main>
</Layout>

<style>
  main {
    padding: 0 1rem;
  }

  #content {
    max-width: 960px;
    padding: 3rem 0 2rem;
    gap: 3rem;
  }

  .hero {
    text-align: center;
    padding: 2rem 0 1rem;
  }

  .hero h1 {
    padding-top: 0;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .tagline {
    font-size: 1.25rem;
    color: #093C4F;
    margin: 0 0 2rem;
  }

  .services,
  .visit {
    width: 100%;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .services h2,
  .visit h2 {
    text-align: center;
    margin: 0 0 1.5rem;
  }

  .service-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
  }

  .service-grid li {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    padding: 1.25rem;
    text-align: center;
    box-shadow: 0 2px 12px rgba(9, 60, 79, 0.08);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .service-grid strong {
    font-size: 1.1rem;
    color: #093C4F;
  }

  .service-grid span {
    color: #4a5b64;
    font-size: 0.95rem;
  }

  .visit {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 2rem;
  }

  .visit-block {
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    padding: 1.75rem;
    box-shadow: 0 2px 12px rgba(9, 60, 79, 0.08);
    text-align: center;
  }

  .visit-block h2 {
    margin-top: 0;
  }

  .visit-block a {
    color: #093C4F;
    font-weight: 600;
  }

  .hours {
    list-style: none;
    padding: 0;
    margin: 0 auto 0.75rem;
    max-width: 280px;
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid rgba(9, 60, 79, 0.1);
  }

  .hours li:last-child {
    border-bottom: none;
  }

  .note {
    color: #4a5b64;
    font-size: 0.9rem;
    margin: 0.5rem 0 0;
  }

  footer {
    color: #4a5b64;
    font-size: 0.9rem;
  }
</style>
