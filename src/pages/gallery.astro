---
import Layout from '../components/Layout.astro';

const photos = [
  { src: '/photos/hero-fruit.png',     alt: 'Summer fruit-themed nails with orange and blue accents' },
  { src: '/photos/nail-purple.png',    alt: 'Purple almond nails with white floral accents' },
  { src: '/photos/nail-bows.png',      alt: 'Green nails with delicate pink bow designs' },
  { src: '/photos/nail-galaxy.png',    alt: 'Galaxy-themed nail art with stars and swirls' },
  { src: '/photos/nail-cats.png',      alt: 'Cream nails with cat characters and polka dots' },
  { src: '/photos/nail-snowflake.png', alt: 'Soft pink nails with white snowflake design' },
];
---

<Layout
  title="Gallery — Golden Glow Nail Studio"
  description="Browse recent nail art from Golden Glow Nail Studio in Staten Island — custom designs by our artists."
>
  <section class="page-header container">
    <p class="eyebrow">Gallery</p>
    <h1>Our Work</h1>
    <p class="lede">
      A sampling of recent designs from our artists. For the latest,
      <a href="https://instagram.com/goldenglownail" target="_blank" rel="noopener">follow us on Instagram</a>.
    </p>
  </section>

  <section class="gallery container">
    <div class="gallery-grid">
      {photos.map(photo => (
        <figure class="tile">
          <img src={photo.src} alt={photo.alt} loading="lazy" />
        </figure>
      ))}
    </div>
  </section>

  <section class="cta-band container">
    <div class="cta-inner">
      <div>
        <h2>Love what you see?</h2>
        <p>Bring your inspiration in — or book a custom design session.</p>
      </div>
      <div class="cta">
        <a href="tel:+17189847777" class="btn primary">Call (718) 984-7777</a>
        <a href="/about" class="btn secondary">About Us</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.25rem;
  }

  .page-header {
    text-align: center;
    padding-top: 4rem;
  }

  .eyebrow {
    color: #21A69A;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.8rem;
    margin: 0 0 0.75rem;
  }

  .page-header h1 {
    padding: 0;
    margin: 0 auto 1rem;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .lede {
    max-width: 560px;
    margin: 0 auto;
    color: #4a5b64;
    line-height: 1.6;
  }

  .lede a {
    color: #21A69A;
    font-weight: 600;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .tile {
    margin: 0;
    overflow: hidden;
    border-radius: 14px;
    box-shadow: 0 4px 16px rgba(9, 60, 79, 0.1);
    background: rgba(255, 255, 255, 0.5);
  }

  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .tile:hover img {
    transform: scale(1.03);
  }

  .cta-band {
    padding-top: 1rem;
  }

  .cta-inner {
    background: linear-gradient(135deg, rgba(33, 166, 154, 0.12), rgba(246, 198, 90, 0.15));
    border-radius: 20px;
    padding: 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .cta-inner h2 {
    margin: 0 0 0.25rem;
  }

  .cta-inner p {
    margin: 0;
    color: #4a5b64;
  }

  .cta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
</style>
