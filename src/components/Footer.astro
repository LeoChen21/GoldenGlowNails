---
---

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-col">
      <h3>Golden Glow Nail Studio</h3>
      <p class="tagline">Where every nail tells a story.</p>
      <p class="socials">
        <a href="https://instagram.com/goldenglownail" target="_blank" rel="noopener">Instagram @goldenglownail</a>
      </p>
    </div>

    <div class="footer-col">
      <h4>Visit</h4>
      <address>
        150 Greaves Lane<br />
        Staten Island, NY 10308<br />
        <a href="tel:+17189847777">(718) 984-7777</a>
      </address>
      <p>
        <a
          href="https://www.google.com/maps/search/?api=1&query=150+Greaves+Lane+Staten+Island+NY+10308"
          target="_blank"
          rel="noopener"
        >Get Directions →</a>
      </p>
    </div>

    <div class="footer-col">
      <h4>Hours</h4>
      <ul class="hours">
        <li><span>Mon – Sat</span><span>9:30 AM – 7:30 PM</span></li>
        <li><span>Sunday</span><span>9:00 AM – 6:00 PM</span></li>
      </ul>
      <p class="note">Open 7 days · Walk-ins welcome</p>
    </div>

    <div class="footer-col">
      <h4>Explore</h4>
      <ul class="link-list">
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/gallery">Gallery</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <p>&copy; {new Date().getFullYear()} Golden Glow Nail Studio. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 4rem;
    background: linear-gradient(180deg, rgba(9, 60, 79, 0.02), rgba(9, 60, 79, 0.08));
    border-top: 1px solid rgba(9, 60, 79, 0.08);
    color: #0D1D24;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 3rem 1.25rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2.5rem;
  }

  .footer-col h3 {
    margin: 0 0 0.5rem;
    font-size: 1.1rem;
    color: #093C4F;
  }

  .footer-col h4 {
    margin: 0 0 0.75rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #093C4F;
  }

  .footer-col p,
  .footer-col address {
    font-style: normal;
    margin: 0 0 0.75rem;
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .footer-col a {
    color: #0D1D24;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease;
  }

  .footer-col a:hover {
    border-color: #21A69A;
  }

  .footer-col .tagline {
    color: #4a5b64;
    font-style: italic;
  }

  .hours,
  .link-list {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem;
  }

  .hours li {
    display: flex;
    justify-content: space-between;
    padding: 0.3rem 0;
    font-size: 0.95rem;
    border-bottom: 1px solid rgba(9, 60, 79, 0.1);
  }

  .hours li:last-child {
    border-bottom: none;
  }

  .link-list li {
    padding: 0.25rem 0;
  }

  .note {
    color: #4a5b64;
    font-size: 0.85rem;
  }

  .footer-bottom {
    border-top: 1px solid rgba(9, 60, 79, 0.08);
    text-align: center;
    padding: 1.25rem;
    color: #4a5b64;
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0;
  }
</style>
